{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-architecture.local/schemas/lock-ir-0.1.json",
  "title": "LockIntermediateRepresentation",
  "description": "Language-agnostic Packwerk-shaped lock IR. Privacy folders are NOT core (Packwerk 3.0 removed). Edge fidelity: constant/import references only unless adapter declares more.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ir_version",
    "package_id",
    "enforce_dependencies",
    "dependencies",
    "edge_fidelity",
    "todo"
  ],
  "properties": {
    "ir_version": { "const": "0.1.0" },
    "package_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable package identity (path or declared name)"
    },
    "root_path": { "type": "string" },
    "enforce_dependencies": {
      "enum": ["true", "strict", "false"],
      "description": "Packwerk-compatible; strict forbids new todo growth without human allow"
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "metadata": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "edge_fidelity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checked", "unproven", "out_of_scope"],
      "properties": {
        "checked": {
          "type": "array",
          "items": {
            "enum": ["constant_reference", "import", "module_dependency"]
          }
        },
        "unproven": {
          "type": "array",
          "items": {
            "enum": ["method_call", "di_string", "dynamic_require", "reflection"]
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "enum": ["initializer", "route", "fixture", "runtime_boot"]
          }
        }
      }
    },
    "todo": {
      "type": "object",
      "description": "Debt lock; fingerprint content-stable (not line ordinal)",
      "additionalProperties": false,
      "required": ["entries", "fingerprint"],
      "properties": {
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["defining_package", "constant", "violation_kinds", "files"],
            "properties": {
              "defining_package": { "type": "string" },
              "constant": { "type": "string" },
              "violation_kinds": {
                "type": "array",
                "minItems": 1,
                "items": { "enum": ["dependency", "privacy_legacy"] }
              },
              "files": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "agent_update_todo": {
      "const": false,
      "description": "Must be false or absent — agents may not enlarge todo without human-owned allow"
    }
  }
}
