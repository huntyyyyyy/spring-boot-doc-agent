{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-architecture.local/schemas/receipt-0.1.json",
  "title": "VerifyReceipt",
  "type": "object",
  "required": ["receipt_version", "run_id", "git_commit", "target_root", "result", "steps", "material_digest", "policy_digest"],
  "properties": {
    "receipt_version": { "const": "0.1.0" },
    "run_id": { "type": "string", "format": "uuid" },
    "git_commit": { "type": "string", "minLength": 1 },
    "target_root": { "type": "string" },
    "result": { "enum": ["pass", "fail", "unknown"] },
    "material_digest": { "type": "string", "description": "Hash of verified content set (Proof-or-Stop freshness)" },
    "policy_digest": { "type": "string", "description": "Hash of lock/policy set used" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["step_id", "kind", "ok", "witness"],
        "properties": {
          "step_id": { "type": "string" },
          "kind": { "enum": ["index_load", "annotation", "resolve", "lock_check", "policy", "claim_put", "claim_withdraw"] },
          "rule_id": { "type": "string" },
          "lock_id": { "type": "string" },
          "ok": { "type": "boolean" },
          "message": { "type": "string" },
          "witness": {
            "type": "object",
            "required": ["file", "line", "column"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 0 },
              "symbol": { "type": "string" },
              "edge_id": { "type": "string" },
              "anchor_digest": { "type": "string" }
            },
            "not": {
              "required": ["llm_text", "rag_chunk"]
            }
          }
        }
      }
    },
    "unknowns": { "type": "array" },
    "claim_dispositions": { "type": "array" }
  }
}
