{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verified-architecture.local/schemas/ea-graph-claim-0.1.json",
  "title": "EAGraphClaim",
  "type": "object",
  "required": ["claim_id", "kind", "anchors", "evidence_strength", "freshness", "disposition"],
  "properties": {
    "claim_id": { "type": "string" },
    "kind": { "enum": ["resolve", "lock_holds", "cycle_absent", "policy"] },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["artifact_id", "content_digest"],
        "properties": {
          "artifact_id": { "type": "string", "description": "Canonical path or sub-path id" },
          "content_digest": { "type": "string" }
        }
      }
    },
    "evidence_strength": { "enum": ["weak", "strong"] },
    "freshness": { "enum": ["fresh", "stale", "unknown"] },
    "disposition": { "enum": ["unaffected", "affected", "unprovable"] },
    "payload": { "type": "object" }
  }
}
