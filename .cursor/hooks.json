{
  "$comment": [
    "Project-native Cursor hooks. Claude PreToolUse policies bridge via",
    "bridge_claude_policy.py. E-DOC1 adds research-map look-first (DOC7/DOC9):",
    "beforeSubmitPrompt inject + Read receipt + deny design writes without it.",
    "postToolUse on tests/** injects non-vacuous receipt witness (E-CPL/TEL).",
    "Cloud loads this file only (not ~/.cursor/hooks.json).",
    "Docs: https://cursor.com/docs/hooks — no sessionStart on cloud agents."
  ],
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/inject_research_map.py",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/bridge_claude_policy.py adapters/claude/hooks/deny_text_search.py",
        "timeout": 15
      },
      {
        "command": "python3 .cursor/hooks/bridge_claude_policy.py adapters/claude/hooks/deny_raw_network.py",
        "timeout": 15
      },
      {
        "command": "python3 .cursor/hooks/bridge_claude_policy.py .claude/hooks/check_pipe_exit_code.py",
        "timeout": 15
      },
      {
        "command": "python3 .cursor/hooks/bridge_claude_policy.py adapters/claude/hooks/require_design_research.py",
        "timeout": 20
      },
      {
        "command": "python3 .cursor/hooks/bridge_claude_policy.py adapters/claude/hooks/require_hardened_tests.py",
        "timeout": 180
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/bridge_claude_policy.py adapters/claude/hooks/deny_text_search.py",
        "matcher": "Grep",
        "timeout": 15
      },
      {
        "command": "python3 .cursor/hooks/require_research_map_read.py",
        "matcher": "Write|StrReplace|EditNotebook",
        "timeout": 15,
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/record_research_map_read.py",
        "matcher": "Read",
        "timeout": 10
      },
      {
        "command": "python3 .cursor/hooks/inject_nonvacuous_test_witness.py",
        "matcher": "Write|StrReplace|EditNotebook",
        "timeout": 10
      }
    ]
  }
}
